package handler

import (
{{- if .SQLite}}
	"strconv"
{{- end}}

	"github.com/gofiber/fiber/v2"
{{- if .SQLite}}
	"github.com/wkqco33/wcli/logging"
	"{{.ModuleName}}/database"
	"{{.ModuleName}}/database/models"
{{- end}}
)

// Hello GET /hello
func Hello(c *fiber.Ctx) error {
	return c.JSON(fiber.Map{"message": "Hello from {{.ProjectName}}!"})
}

{{- if .SQLite}}

// ListExamples GET /examples
func ListExamples(c *fiber.Ctx) error {
	var items []models.Example
	if err := database.DB.Find(&items).Error; err != nil {
		logging.GetLogger().Log(logging.LevelError, "examples 조회 실패: %v", err)
		return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": "internal server error"})
	}
	return c.JSON(items)
}

// CreateExample POST /examples
func CreateExample(c *fiber.Ctx) error {
	var item models.Example
	if err := c.BodyParser(&item); err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": err.Error()})
	}
	if err := database.DB.Create(&item).Error; err != nil {
		logging.GetLogger().Log(logging.LevelError, "example 생성 실패: %v", err)
		return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": "internal server error"})
	}
	return c.Status(fiber.StatusCreated).JSON(item)
}

// DeleteExample DELETE /examples/:id
func DeleteExample(c *fiber.Ctx) error {
	id, err := strconv.Atoi(c.Params("id"))
	if err != nil {
		return c.Status(fiber.StatusBadRequest).JSON(fiber.Map{"error": "invalid id"})
	}
	if err := database.DB.Delete(&models.Example{}, id).Error; err != nil {
		logging.GetLogger().Log(logging.LevelError, "example 삭제 실패 (id=%d): %v", id, err)
		return c.Status(fiber.StatusInternalServerError).JSON(fiber.Map{"error": "internal server error"})
	}
	return c.JSON(fiber.Map{"deleted": id})
}
{{- end}}
