package handler

import (
	"net/http"
{{- if .SQLite}}
	"strconv"
{{- end}}

	"github.com/gin-gonic/gin"
{{- if .SQLite}}
	"{{.ModuleName}}/database"
	"{{.ModuleName}}/database/models"
{{- end}}
)

// Hello GET /hello
func Hello(c *gin.Context) {
	c.JSON(http.StatusOK, gin.H{"message": "Hello from {{.ProjectName}}!"})
}

{{- if .SQLite}}

// ListExamples GET /examples
func ListExamples(c *gin.Context) {
	var items []models.Example
	if err := database.DB.Find(&items).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}
	c.JSON(http.StatusOK, items)
}

// CreateExample POST /examples
func CreateExample(c *gin.Context) {
	var item models.Example
	if err := c.ShouldBindJSON(&item); err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": err.Error()})
		return
	}
	if err := database.DB.Create(&item).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}
	c.JSON(http.StatusCreated, item)
}

// DeleteExample DELETE /examples/:id
func DeleteExample(c *gin.Context) {
	id, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		c.JSON(http.StatusBadRequest, gin.H{"error": "invalid id"})
		return
	}
	if err := database.DB.Delete(&models.Example{}, id).Error; err != nil {
		c.JSON(http.StatusInternalServerError, gin.H{"error": err.Error()})
		return
	}
	c.JSON(http.StatusOK, gin.H{"deleted": id})
}
{{- end}}
