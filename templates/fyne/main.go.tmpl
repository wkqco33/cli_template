package main

import (
	"fyne.io/fyne/v2/app"
	wcliconfig "github.com/seoyc/wcli/config"
	"{{.ModuleName}}/config"
	"{{.ModuleName}}/ui"
)

func main() {
	// CLI 설정 로드 (환경변수 및 config.yaml 지원)
	var cfg config.Config
	_ = wcliconfig.Load(&cfg,
		wcliconfig.WithFiles("config.yaml"),
		wcliconfig.WithEnv(),
		wcliconfig.WithPrefix("{{.ProjectName | upper}}"),
	)

	a := app.New()
	w := ui.NewMainWindow(a, &cfg)
	w.ShowAndRun()
}
